NODE_ENV=development
HOST=0.0.0.0
PORT=3010
LOG_LEVEL=info

# From the host machine. Inside Compose use postgres:5432.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DB_MIGRATE_ON_START=true

# Kafka from the host machine; inside Compose use kafka:19092.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-analytics-service
KAFKA_GROUP_ID=streamly-analytics-v1
KAFKA_TOPIC_EVENTS=streamly.events
KAFKA_FROM_BEGINNING=false
KAFKA_ENABLED=true

# Set a long random value in real deployments. Optional in local development.
INGEST_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
