# Auth service local development configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3002

# Use the host-mapped port when running this service on your host.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DB_POOL_MAX=10

# Generate a unique random secret, e.g. openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_ISSUER=streamly-auth
JWT_AUDIENCE=streamly-api

# Refresh tokens are opaque random values, hashed before storing in PostgreSQL.
REFRESH_TOKEN_TTL_DAYS=30

# Only enable secure cookies when serving over HTTPS.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
