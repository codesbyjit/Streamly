NODE_ENV=development
HOST=0.0.0.0
PORT=3006
LOG_LEVEL=info

# Use localhost from host machine; use postgres:5432 from Docker network.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_SCHEMA=streaming
DB_POOL_MAX=10

# Verify the same issuer/audience and signing algorithm as auth-service.
# This starter uses HS256. Use a shared secret only for local development;
# prefer asymmetric JWT signing and JWKS in production.
JWT_SECRET=replace_with_a_long_random_development_secret_at_least_32_chars
JWT_ISSUER=streamly-auth
JWT_AUDIENCE=streamly-api

# S3-compatible MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamly
S3_SECRET_KEY=streamly_minio_dev_password
S3_BUCKET=streamly-media
S3_FORCE_PATH_STYLE=true

# The client-visible URL for HLS assets. For local dev, MinIO is exposed on localhost:9000.
# Production should use a CDN or a private origin with signed delivery.
PLAYBACK_BASE_URL=http://localhost:9000/streamly-media
PLAYBACK_URL_TTL_SECONDS=900
PLAYBACK_TOKEN_TTL_SECONDS=300
PLAYBACK_TOKEN_SECRET=replace_with_another_long_random_development_secret_at_least_32_chars

# Optional: check auth/content service ownership and publication state before playback.
# If false, this service only checks its local video_assets table and user identity.
CONTENT_SERVICE_URL=
AUTH_SERVICE_URL=
UPSTREAM_TIMEOUT_MS=2500

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
