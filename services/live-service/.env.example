NODE_ENV=development
PORT=3012
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://:streamly_redis_dev_password@localhost:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=streamly:live:

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-live-service
KAFKA_TOPIC_PREFIX=

INTERNAL_API_KEY=replace_with_a_long_random_local_key
STREAM_INGEST_BASE_URL=rtmp://localhost:1935/live
STREAM_PLAYBACK_BASE_URL=http://localhost:8888/live
MAX_ACTIVE_STREAMS_PER_USER=3
