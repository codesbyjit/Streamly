NODE_ENV=development
HOST=0.0.0.0
PORT=3008
LOG_LEVEL=info

# Host-run service uses localhost. In Docker, use postgres:5432.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DB_POOL_MAX=10
DB_SSL=false
DB_MIGRATE_ON_START=true

# Gateway should validate the end-user token and forward trusted identity.
# Social service also requires this shared secret for internal gateway traffic.
INTERNAL_API_KEY=replace-with-a-long-random-local-secret
TRUSTED_ID_HEADER=x-user-id
TRUSTED_INTERNAL_KEY_HEADER=x-internal-api-key

# Optional Kafka event publishing. Disable locally if Kafka isn't available.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-social-service
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
MAX_COMMENT_LENGTH=5000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
