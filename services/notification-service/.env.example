NODE_ENV=development
HOST=0.0.0.0
PORT=3009
LOG_LEVEL=info

# Use the same PostgreSQL instance as the rest of Streamly, but a service-owned schema.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_SCHEMA=notification
DATABASE_SSL=false
DB_POOL_MAX=10

# Kafka: localhost from host machine; kafka:19092 from a Compose container.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-notification-service
KAFKA_GROUP_ID=streamly-notification-service-v1
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPICS=video.published,channel.subscribed,comment.created

# SMTP: Mailpit local default. For container-to-container use mailpit:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Streamly <notifications@streamly.local>
EMAIL_ENABLED=false

# Optional API authentication. If set, service verifies HS256 JWTs.
# Must match the secret/algorithm used by the auth service.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=
JWT_AUDIENCE=

# Notification delivery defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
WORKER_ENABLED=true
