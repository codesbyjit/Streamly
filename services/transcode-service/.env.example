# Kafka: use localhost:9092 when running on host; kafka:19092 in Docker network
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-transcode-service
KAFKA_GROUP_ID=streamly-transcode-workers
KAFKA_INPUT_TOPIC=video.uploaded
KAFKA_READY_TOPIC=video.processing.completed
KAFKA_FAILED_TOPIC=video.processing.failed
KAFKA_FROM_BEGINNING=false

# MinIO/S3. Use http://localhost:9000 on host; http://minio:9000 in Compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamly
S3_SECRET_KEY=streamly_minio_dev_password
S3_BUCKET=streamly-media
S3_FORCE_PATH_STYLE=true

# FFmpeg worker
WORK_DIR=./.work
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_RESOLUTIONS=360,480,720,1080
HLS_SEGMENT_SECONDS=6
TRANSCODE_CONCURRENCY=1
MAX_SOURCE_BYTES=5368709120
JOB_TIMEOUT_MS=3600000
CLEANUP_WORK_DIR=true

# Structured logs
LOG_LEVEL=info
