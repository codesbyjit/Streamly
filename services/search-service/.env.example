NODE_ENV=development
PORT=3007
HOST=0.0.0.0
LOG_LEVEL=info

# Inside Docker Compose, use http://opensearch:9200.
# When running the service directly on your host, use http://localhost:9200.
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_INDEX=streamly-videos-v1
OPENSEARCH_REQUEST_TIMEOUT_MS=5000

# Optional Kafka indexing consumer. Leave KAFKA_ENABLED=false for API-only mode.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-search-service
KAFKA_GROUP_ID=streamly-search-service-v1
KAFKA_TOPICS=video.published,video.updated,video.deleted
KAFKA_FROM_BEGINNING=false

# Optional protection for admin/internal indexing routes.
# Set a long random value in shared environments; leave empty for local development.
INTERNAL_API_KEY=

# Optional CORS origins, comma-separated. Empty disables CORS headers.
CORS_ORIGINS=
