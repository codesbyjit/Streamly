NODE_ENV=development
HOST=0.0.0.0
PORT=3002

# For local apps running on your host machine.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DB_POOL_MAX=10
DB_SSL=false

# Set this to a long random value outside local development.
INTERNAL_API_KEY=local-streamly-internal-key-change-me

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
