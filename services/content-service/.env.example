NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info

# If running this service on the host:
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly

# If running inside the Streamly Compose network, use:
# DATABASE_URL=postgresql://streamly:streamly_dev_password@postgres:5432/streamly

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
CORS_ORIGIN=http://localhost:3000
