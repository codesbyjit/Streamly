NODE_ENV=development
SERVICE_NAME=video-processing-service
LOG_LEVEL=info

# Kafka (Docker host defaults shown; use kafka:19092 inside Compose)
KAFKA_CLIENT_ID=streamly-video-processing
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=streamly-video-processing-v1
KAFKA_INPUT_TOPIC=video.uploaded
KAFKA_OUTPUT_TOPIC=video.processing.events
KAFKA_DLQ_TOPIC=video.processing.dlq
KAFKA_FROM_BEGINNING=false

# PostgreSQL. The worker uses its own schema and table for job state.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_SCHEMA=video_processing

# S3-compatible storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamly
S3_SECRET_KEY=streamly_minio_dev_password
S3_BUCKET=streamly-media
S3_FORCE_PATH_STYLE=true
S3_TLS=false

# Video processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORK_DIR=./.work
MAX_SOURCE_BYTES=5368709120
MAX_VIDEO_SECONDS=14400
MAX_CONCURRENT_JOBS=1
TRANSCODE_TIMEOUT_MS=7200000
HLS_SEGMENT_SECONDS=6
RENDITIONS=360p,480p,720p,1080p
THUMBNAIL_SECONDS=2
PRESERVE_SOURCE=true
