NODE_ENV=development
HOST=0.0.0.0
PORT=3004
LOG_LEVEL=info

# Use localhost when running this service on your host.
DATABASE_URL=postgresql://streamly:streamly_dev_password@localhost:5432/streamly
DATABASE_POOL_MAX=10

# MinIO/S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamly-media
S3_ACCESS_KEY=streamly
S3_SECRET_KEY=streamly_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=600
S3_UPLOAD_MAX_BYTES=2147483648
S3_ALLOWED_CONTENT_TYPES=video/mp4,video/webm,video/quicktime,video/x-matroska
S3_KEY_PREFIX=originals

# Kafka. Leave empty to disable event publishing locally.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=streamly-upload-service
KAFKA_TOPIC_VIDEO_UPLOADED=streamly.video.uploaded.v1
KAFKA_SSL=false

# This is only a local-development identity mode. Production must use
# a verified gateway/JWT integration; do not trust arbitrary client headers.
DEV_AUTH_ENABLED=true
DEV_USER_HEADER=x-dev-user-id
DEV_DEFAULT_USER_ID=local-user-001

UPLOAD_SESSION_TTL_HOURS=24
CORS_ORIGINS=http://localhost:3000
